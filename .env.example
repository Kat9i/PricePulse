# =============================================================================
# PricePulse — переменные окружения
# Скопируй этот файл в .env и заполни значения
# cp .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
# PostgreSQL
# Придумай сам — эти значения используются при первом запуске docker-compose
# для инициализации базы данных. После создания БД менять нельзя без миграции.
# -----------------------------------------------------------------------------
POSTGRES_DB=pricepulse
POSTGRES_USER=pricepulse
POSTGRES_PASSWORD=                  # сгенерируй: openssl rand -hex 16

# Строка подключения — собирается из переменных выше, менять не нужно
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}


# -----------------------------------------------------------------------------
# Telegram Bot
# BOT_TOKEN:  @BotFather → /newbot → токен вида 7123456789:AAF...
# WEBHOOK_URL: домен сервера без слеша, например https://pricepulse.example.com
#              Локально можно оставить пустым — worker работает в polling-режиме
# -----------------------------------------------------------------------------
BOT_TOKEN=
WEBHOOK_URL=


# -----------------------------------------------------------------------------
# JWT — токены авторизации пользователей
# SECRET_KEY: сгенерируй случайную строку минимум 32 символа
#             python -c "import secrets; print(secrets.token_hex(32))"
# JWT_ALGORITHM: алгоритм подписи, менять не нужно
# JWT_EXPIRE_DAYS: срок жизни токена в днях (по умолчанию 30)
# -----------------------------------------------------------------------------
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30


# -----------------------------------------------------------------------------
# ЮКасса — платёжная система
# Регистрация: https://yookassa.ru
# YUKASSA_SHOP_ID:    личный кабинет → Настройки магазина → shopId
# YUKASSA_SECRET_KEY: личный кабинет → Настройки → Ключи API → Секретный ключ
# PAYMENT_PROVIDER_TOKEN: @BotFather → выбрать бота → Payments → ЮКасса → токен
# Можно оставить пустыми — платежи отключатся с ошибкой 503
# -----------------------------------------------------------------------------
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
PAYMENT_PROVIDER_TOKEN=


# -----------------------------------------------------------------------------
# Прокси для парсеров WB и Ozon
# Нужны если сервер получает 403/429 от маркетплейсов
# Формат: http://user:pass@host:port через запятую
# Оставь пустым если прокси не нужны
# -----------------------------------------------------------------------------
PROXY_LIST=


# -----------------------------------------------------------------------------
# Playwright (headless-браузер для парсинга)
# true  — без GUI, для сервера
# false — с GUI, для локальной отладки
# -----------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true


# -----------------------------------------------------------------------------
# Лимиты тарифов (количество одновременно отслеживаемых товаров)
# FREE_TRACKING_LIMIT: лимит для бесплатного тарифа (по умолчанию 10)
# PRO_TRACKING_LIMIT:  лимит для PRO-тарифа (по умолчанию 50)
# -----------------------------------------------------------------------------
FREE_TRACKING_LIMIT=10
PRO_TRACKING_LIMIT=50


# -----------------------------------------------------------------------------
# CORS — разрешённые домены для запросов к API
# Локально: http://localhost:5173
# Продакшен: https://web.telegram.org  (домен Telegram Mini Apps)
# Несколько доменов — через запятую без пробелов
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173
