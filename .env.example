# База данных
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/pricepulse

# Telegram
BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_URL=https://yourdomain.com

# JWT — минимум 32 символа
SECRET_KEY=your_secret_key_here_min_32_chars_change_me

# ЮКасса
YUKASSA_SHOP_ID=your_shop_id
YUKASSA_SECRET_KEY=your_secret_key

# Прокси (через запятую)
PROXY_LIST=http://user:pass@host:port,http://user:pass@host2:port2

# Playwright
PLAYWRIGHT_HEADLESS=true
