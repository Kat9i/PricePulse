# PostgreSQL — используется docker-compose и DATABASE_URL должен совпадать
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# База данных (собирается из переменных выше)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Telegram
BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_URL=https://yourdomain.com

# JWT — минимум 32 символа
SECRET_KEY=your_secret_key_here_min_32_chars_change_me

# ЮКасса
YUKASSA_SHOP_ID=your_shop_id
YUKASSA_SECRET_KEY=your_secret_key
PAYMENT_PROVIDER_TOKEN=your_telegram_payment_provider_token

# Прокси (через запятую)
PROXY_LIST=http://user:pass@host:port,http://user:pass@host2:port2

# Playwright
PLAYWRIGHT_HEADLESS=true

# CORS — через запятую: https://web.telegram.org,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
